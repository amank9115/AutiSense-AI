# ══════════════════════════════════════════════════════════════════════════════
# AutiSense-AI — Git Ignore Rules
# ══════════════════════════════════════════════════════════════════════════════

# ── Environment secrets (NEVER commit) ───────────────────────────────────────
.env
.env.local
.env.*.local
*.env
backend/.env
backend/.env.local
frontend/.env
frontend/.env.local
ml-service/.env
ml-service/.env.local

# ── Node dependencies ────────────────────────────────────────────────────────
node_modules/

# ── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
.vite/
.next/

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
run-logs/

# ── Python ───────────────────────────────────────────────────────────────────
.venv/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# ── Trained model artifacts (large binaries — regenerate with train_model.py)
ml-service/models/*.pkl
ml-service/app/*.pkl
*.pkl

# ── Database files ───────────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ── Upload directories ───────────────────────────────────────────────────────
ml-service/ai-engine/uploads/
uploads/

# ── OS / Editor junk ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Package lock files (only root + service-level are committed) ─────────────
# package-lock.json is committed — do not ignore

# ── Docker volumes ───────────────────────────────────────────────────────────
mongo_data/
