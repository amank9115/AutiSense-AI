# ──────────────────────────────────────────────────────────────────────────────
# AutiSense-AI — Frontend Environment Variables (Template)
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL.
# Leave EMPTY (recommended) so the browser uses relative URLs that route through
# the Next.js server-side proxy (see rewrites in next.config.ts). This keeps the
# backend private and lets the app work from any device that can reach the frontend.
# Only set an explicit URL (no trailing slash) if you intend to expose the backend
# directly to the browser — which also requires configuring backend CORS.
NEXT_PUBLIC_API_BASE_URL=
