# ──────────────────────────────────────────────────────────────────────────────
# AutiSense-AI — Backend Environment Variables (Template)
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/autisense

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS

# Allowed CORS origins (comma-separated)
# In production, list specific frontend domains only
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# ── Account Lockout ─────────────────────────────────────────────────────────────
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=900

# ── Python ML Service Gateway ─────────────────────────────────────────────────
PY_ML_ENABLED=true
PY_ML_BASE_URL=http://127.0.0.1:8001
PY_ML_TIMEOUT_MS=2500

# ── Redis (for BullMQ background jobs) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=AutiSense <noreply@yourdomain.com>

# ── AI Engine (Groq) ──────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AI_ENGINE_ENABLED=false
AI_ENGINE_BASE_URL=http://127.0.0.1:5000
AI_ENGINE_TIMEOUT_MS=3500

# ── Ollama (Local AI, fallback if no Groq) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ── AWS S3 Storage ───────────────────────────────────────────────────────────
S3_BUCKET=autisense-reports
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=your-secret-key
# For S3-compatible services (MinIO, LocalStack):
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true

# ── Feature Flags ──────────────────────────────────────────────────────────────
# Format: FF_<FLAG_NAME>=true|false
# Available flags:
# FF_ML_CAMERA_ENABLED=false
# FF_ML_PREDICTIONS_ENABLED=true
# FF_AI_CHAT_ENABLED=true
# FF_EMAIL_NOTIFICATIONS_ENABLED=true
# FF_ADVANCED_ANALYTICS_ENABLED=false
# FF_VIDEO_RECORDING_ENABLED=false
# FF_MULTI_CHILD_PROFILES_ENABLED=true
# FF_DOCTOR_PORTAL_ENABLED=false
# FF_EXPORT_REPORTS_ENABLED=true
# FF_REAL_TIME_PREDICTIONS_ENABLED=true
