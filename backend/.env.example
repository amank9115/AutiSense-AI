# ──────────────────────────────────────────────────────────────────────────────
# AutiSense-AI — Backend Environment Variables (Template)
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/autisense

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=production
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ── Python ML Service Gateway ─────────────────────────────────────────────────
PY_ML_ENABLED=true
PY_ML_BASE_URL=http://127.0.0.1:8001
PY_ML_TIMEOUT_MS=2500

# ── Redis (for BullMQ background jobs) ────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
EMAIL_FROM=AutiSense <noreply@yourdomain.com>

# ── AI Engine (Groq) ──────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AI_ENGINE_ENABLED=false
AI_ENGINE_BASE_URL=http://127.0.0.1:5000
AI_ENGINE_TIMEOUT_MS=3500

# ── Ollama (Local AI, fallback if no Groq) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
