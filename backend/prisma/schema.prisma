// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────────

enum Role {
  parent
  doctor
  clinician
  super_admin
}

enum ScreeningStatus {
  pending
  in_progress
  completed
  archived
  failed
}

enum RiskLevel {
  low
  medium
  high
  very_high
}

enum ReportFormat {
  pdf
  csv
  json
}

enum Plan {
  free
  starter
  pro
  enterprise
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

enum ReviewStatus {
  pending
  reviewed
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
}

// ──────────────────────────────────────────────────────────────────────────────
// Core User Models
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id                     String                @id @default(uuid())
  name                   String
  email                  String                @unique
  phone                  String
  passwordHash           String
  role                   Role                  @default(parent)
  provider               String                @default("local")
  emailVerified          Boolean               @default(false)
  emailVerificationToken String?
  tokenExpiresAt         DateTime?
  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?

  // Doctor professional profile (nullable; only relevant for doctor/clinician roles)
  licenseNumber          String?
  specialization         String?
  hospital               String?
  yearsExperience        Int?

  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  // Relations
  children               Child[]               @relation("ParentChildren")
  screeningSessions     ScreeningSession[]    @relation("UserScreeningSessions")
  chatSessions          ChatSession[]         @relation("UserChatSessions")
  refreshTokens          RefreshToken[]        @relation("UserRefreshTokens")
  organizationMemberships OrganizationMember[] @relation("UserOrgMemberships")
  ownedOrganizations     Organization[]        @relation("OrgOwner")
  sharedReports          ReportShare[]         @relation("SharedReports")
  receivedReports        ReportShare[]         @relation("ReceivedReports")
  doctorAppointments     Appointment[]         @relation("DoctorAppointments")
  parentAppointments     Appointment[]         @relation("ParentAppointments")

  @@index([email])
  @@index([role])
}

// Refresh Token for session management
model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique // SHA-256 hash of the refresh token
  familyId    String    // Token family for rotation tracking
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  user        User      @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
}

model Child {
  id                 String              @id @default(uuid())
  parentId           String
  organizationId     String?
  name               String
  dateOfBirth        DateTime
  gender             String?
  medicalNotes       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  parent             User                @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  screeningSessions  ScreeningSession[]  @relation("ChildScreeningSessions")
  appointments       Appointment[]       @relation("ChildAppointments")

  @@index([parentId])
  @@index([organizationId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Screening Models
// ──────────────────────────────────────────────────────────────────────────────

model ScreeningSession {
  id                 String              @id @default(uuid())
  userId             String
  childId            String
  organizationId     String?
  status             ScreeningStatus     @default(pending)

  // Metadata
  duration           Int?                // in seconds
  frameCount         Int?                // total frames analyzed

  // Results
  riskScore          Float?              // 0-100
  riskLevel          RiskLevel?
  summary            String?

  // Additional data
  metadata           Json?               // Camera settings, quality metrics, etc.

  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  user               User                @relation("UserScreeningSessions", fields: [userId], references: [id], onDelete: Cascade)
  child              Child               @relation("ChildScreeningSessions", fields: [childId], references: [id], onDelete: Cascade)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  analysisData       AnalysisData?       @relation("SessionAnalysisData")
  results            ScreeningResult?    @relation("SessionResults")
  report             Report?             @relation("SessionReport")
  reportShares       ReportShare[]

  @@index([userId])
  @@index([childId])
  @@index([organizationId])
  @@index([status])
}

model ScreeningResult {
  id                 String              @id @default(uuid())
  sessionId          String              @unique
  
  // Risk Assessment
  riskScore          Float               // 0-100
  riskLevel          RiskLevel
  confidence         Float?              // Model confidence 0-1
  
  // Behavioral Breakdown
  behaviors          Json                // Array of detected behaviors with timestamps
  emotionalPatterns  Json?               // Emotional analysis data
  
  // Clinical Summary
  summary            String?
  recommendations    Json?               // Store as JSON array instead
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  session            ScreeningSession    @relation("SessionResults", fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model AnalysisData {
  id                 String              @id @default(uuid())
  sessionId          String              @unique
  
  // Frame metrics
  frameCount         Int
  averageConfidence  Float?              // Average detection confidence
  
  // Behavior timeline
  behaviors          Json                // Array of detected behaviors with frame indices
  
  // Emotion timeline
  emotions           Json?               // Emotion detection data with timestamps
  
  // Additional metrics
  metadata           Json?
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  session            ScreeningSession    @relation("SessionAnalysisData", fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Report {
  id                 String              @id @default(uuid())
  sessionId          String              @unique
  
  format             ReportFormat        @default(pdf)
  filePath           String              // S3 path or local path
  
  // Report lifecycle
  generatedAt        DateTime            @default(now())
  expiresAt          DateTime?           // For temporary download links
  
  // Metadata
  metadata           Json?               // Report generation settings, etc.
  
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  session            ScreeningSession    @relation("SessionReport", fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ReportShare {
  id          String       @id @default(uuid())
  sessionId   String
  sharedById  String
  doctorId    String
  status      ReviewStatus @default(pending)
  doctorNotes String?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  session     ScreeningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sharedBy    User             @relation("SharedReports", fields: [sharedById], references: [id])
  doctor      User             @relation("ReceivedReports", fields: [doctorId], references: [id])

  @@unique([sessionId, doctorId])
  @@index([doctorId])
  @@index([sharedById])
  @@index([status])
}

model Appointment {
  id           String            @id @default(uuid())
  doctorId     String
  parentId     String
  childId      String
  scheduledAt  DateTime
  durationMins Int               @default(30)
  reason       String?
  status       AppointmentStatus @default(scheduled)
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  doctor       User              @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Cascade)
  parent       User              @relation("ParentAppointments", fields: [parentId], references: [id], onDelete: Cascade)
  child        Child             @relation("ChildAppointments", fields: [childId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([parentId])
  @@index([childId])
  @@index([scheduledAt])
  @@index([status])
}

// ──────────────────────────────────────────────────────────────────────────────
// AI & Chat Models
// ──────────────────────────────────────────────────────────────────────────────

model ChatSession {
  id                 String              @id @default(uuid())
  userId             String
  organizationId     String?
  title              String?

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // Relations
  user               User                @relation("UserChatSessions", fields: [userId], references: [id], onDelete: Cascade)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  messages           ChatMessage[]       @relation("SessionMessages")

  @@index([userId])
  @@index([organizationId])
}

model ChatMessage {
  id                 String              @id @default(uuid())
  sessionId          String
  
  role               String              // 'user' or 'assistant'
  content            String
  
  // Optional metadata
  metadata           Json?
  
  createdAt          DateTime            @default(now())

  // Relations
  session            ChatSession         @relation("SessionMessages", fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ──────────────────────────────────────────────────────────────────────────────
// SaaS Multi-Tenancy Models
// ──────────────────────────────────────────────────────────────────────────────

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  ownerId     String
  plan        Plan     @default(free)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner            User                @relation("OrgOwner", fields: [ownerId], references: [id])
  members          OrganizationMember[]
  screeningSessions ScreeningSession[]
  children         Child[]
  chatSessions     ChatSession[]
  subscription     Subscription?
  apiKeys          ApiKey[]
  webhooks         WebhookEndpoint[]
  auditLogs        AuditLog[]

  @@index([ownerId])
  @@index([slug])
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("UserOrgMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model Subscription {
  id               String             @id @default(uuid())
  organizationId   String             @unique
  plan             Plan               @default(free)
  status           SubscriptionStatus @default(active)
  stripeCustomerId String?
  stripePriceId    String?
  stripeSubId      String?
  currentPeriodEnd DateTime?
  usageLimits      Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([stripeCustomerId])
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  keyHash        String    @unique
  keyPrefix      String
  scopes         Json
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([keyHash])
}

model WebhookEndpoint {
  id             String   @id @default(uuid())
  organizationId String
  url            String
  secret         String
  events         Json
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id             String    @id @default(uuid())
  organizationId String?
  actorId        String?
  actorType      String    @default("user")
  action         String
  resourceType   String
  resourceId     String?
  changes        Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Legacy Models (for backward compatibility - can be deprecated)
// ──────────────────────────────────────────────────────────────────────────────

model SessionHistory {
  id               String   @id @default(uuid())
  childName        String
  date             String
  duration         String
  attentionAverage Float
  riskScore        Float
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // TODO: Deprecate - Use ScreeningSession, AnalysisData, and ScreeningResult instead
}

model PreScreeningProfile {
  id               String   @id @default(uuid())
  childName        String
  age              String
  dateOfBirth      String
  gender           String
  parentName       String
  parentPhone      String
  parentEmail      String
  homeAddress      String
  city             String
  state            String
  emergencyContact String
  medicalNotes     String   @default("")
  location         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // TODO: Deprecate - Use User and Child models instead
}

model Message {
  id        String   @id @default(uuid())
  from      Role
  name      String
  message   String
  at        String
  createdAt DateTime @default(now())

  // TODO: Deprecate - Use ChatMessage instead
}

