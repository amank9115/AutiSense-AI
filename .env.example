# ──────────────────────────────────────────────────────────────────────────────
# AutiSense-AI — Environment Variables Reference
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file into each service as .env and fill in your values.
# NEVER commit real .env files to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Frontend (frontend/.env) ─────────────────────────────────────────────────
# Leave NEXT_PUBLIC_API_BASE_URL empty to route through the Next.js proxy.
NEXT_PUBLIC_API_BASE_URL=
# Server-side proxy target (rewrites in next.config.ts). Docker: http://backend:4000
BACKEND_URL=http://localhost:4000

# ── Backend (backend/.env) ───────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma.
DATABASE_URL=postgresql://postgres:password@localhost:5432/autisense?schema=public
PORT=4000
NODE_ENV=development
SEED_DEMO_DATA=false

# Auth — MUST be a long random string (min 32 chars) in production.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_MIN_32_CHARS

# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (BullMQ + caching).
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL container credentials (docker-compose.prod.yml).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=autisense

# Python ML Service Gateway
PY_ML_ENABLED=false
PY_ML_BASE_URL=http://127.0.0.1:8001
PY_ML_TIMEOUT_MS=2500

# AI Engine Gateway
AI_ENGINE_ENABLED=false
AI_ENGINE_BASE_URL=http://127.0.0.1:5000
AI_ENGINE_TIMEOUT_MS=3500

# Gemini AI (for AI Assistant chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── ML Service (ml-service/.env) ─────────────────────────────────────────────
# No required env vars — configure via pyproject.toml
