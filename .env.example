# ──────────────────────────────────────────────────────────────────────────────
# AutiSense-AI — Environment Variables Reference
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file into each service as .env and fill in your values.
# NEVER commit real .env files to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Frontend (frontend/.env) ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:4000/api/v1

# ── Backend (backend/.env) ───────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxx.mongodb.net/autisense?retryWrites=true&w=majority
PORT=4000
MONGO_TLS_ALLOW_INVALID=false
MONGO_IP_FAMILY=4
SEED_DEMO_DATA=false

# Python ML Service Gateway
PY_ML_ENABLED=false
PY_ML_BASE_URL=http://127.0.0.1:8001
PY_ML_TIMEOUT_MS=2500

# AI Engine Gateway
AI_ENGINE_ENABLED=false
AI_ENGINE_BASE_URL=http://127.0.0.1:5000
AI_ENGINE_TIMEOUT_MS=3500

# Gemini AI (for AI Assistant chat)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── ML Service (ml-service/.env) ─────────────────────────────────────────────
# No required env vars — configure via pyproject.toml
